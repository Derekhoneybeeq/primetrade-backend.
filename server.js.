
"use strict";

const http = require("http");
const crypto = require("crypto");

const PORT = process.env.PORT || 3000;
const BINANCE_KEY = process.env.BINANCE_API_KEY;
const BINANCE_SECRET = process.env.BINANCE_API_SECRET;
const PRIME_TOKEN = process.env.PRIMETRADE_ACCESS_TOKEN;
const BINANCE_URL = "https://testnet.binance.vision";

function reply(res, status, data) {
  res.writeHead(status, {
    "Content-Type": "application/json; charset=utf-8",
    "Cache-Control": "no-store",
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods": "GET, OPTIONS",
    "Access-Control-Allow-Headers": "Authorization, Content-Type"
  });
  res.end(JSON.stringify(data));
}

function validToken(req) {
  const header = req.headers.authorization || "";
  if (!PRIME_TOKEN || !header.startsWith("Bearer ")) return false;

  const provided = Buffer.from(header.slice(7));
  const expected = Buffer.from(PRIME_TOKEN);

  return provided.length === expected.length &&
    crypto.timingSafeEqual(provided, expected);
}

async function fetchAccount() {
  if (!BINANCE_KEY || !BINANCE_SECRET) {
    throw new Error("Binance API credentials are missing in Render");
  }

  const params = new URLSearchParams({
    recvWindow: "5000",
    timestamp: Date.now().toString()
  });

  const signature = crypto
    .createHmac("sha256", BINANCE_SECRET)
    .update(params.toString())
    .digest("hex");

  const url = BINANCE_URL + "/api/v3/account?" +
    params.toString() + "&signature=" + signature;

  const response = await fetch(url, {
    headers: { "X-MBX-APIKEY": BINANCE_KEY },
    signal: AbortSignal.timeout(10000)
  });

  const data = await response.json();

  if (!response.ok) {
    throw new Error(data.msg || "Binance rejected the account request");
  }

  return data;
}

const server = http.createServer(async (req, res) => {
  const pathname = new URL(req.url, "http://localhost").pathname;

  if (req.method === "OPTIONS") {
    res.writeHead(204, {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, OPTIONS",
      "Access-Control-Allow-Headers": "Authorization, Content-Type"
    });
    return res.end();
  }

  if (req.method === "GET" && pathname === "/health") {
    return reply(res, 200, {
      app: "PrimeTrade",
      status: "online",
      mode: "testnet",
      message: "Backend is responding"
    });
  }

  if (req.method === "GET" && pathname === "/api/account") {
    if (!PRIME_TOKEN) {
      return reply(res, 503, {
        error: "PrimeTrade access token is not configured"
      });
    }

    if (!validToken(req)) {
      return reply(res, 401, {
        error: "Unauthorized",
        message: "A valid PrimeTrade access token is required"
      });
    }

    try {
      const account = await fetchAccount();
      const balances = (account.balances || []).filter(
        b => Number(b.free) > 0 || Number(b.locked) > 0
      );

      return reply(res, 200, {
        app: "PrimeTrade",
        connected: true,
        mode: "testnet",
        accountType: account.accountType,
        canTrade: account.canTrade,
        balances
      });
    } catch (error) {
      console.error("Account request failed:", error.message);
      return reply(res, 502, {
        error: "Binance account request failed",
        message: error.message
      });
    }
  }

  return reply(res, 404, { error: "Endpoint not found" });
});

server.listen(PORT, "0.0.0.0", () => {
  console.log("PrimeTrade backend listening on " + PORT);
});
