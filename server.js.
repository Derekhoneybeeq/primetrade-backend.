
"use strict";

const http = require("http");
const crypto = require("crypto");

const PORT = process.env.PORT || 3000;
const BINANCE_KEY = process.env.BINANCE_API_KEY;
const BINANCE_SECRET = process.env.BINANCE_API_SECRET;
const PRIME_TOKEN = process.env.PRIMETRADE_ACCESS_TOKEN;
const BINANCE_URL = "https://testnet.binance.vision";

function send(res, status, body) {
  res.writeHead(status, {
    "Content-Type": "application/json; charset=utf-8",
    "Cache-Control": "no-store",
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods": "GET, OPTIONS",
    "Access-Control-Allow-Headers": "Authorization, Content-Type"
  });
  res.end(JSON.stringify(body));
}

function isAuthorized(req) {
  const auth = req.headers.authorization || "";
  if (!PRIME_TOKEN || !auth.startsWith("Bearer ")) return false;

  const given = Buffer.from(auth.slice(7));
  const expected = Buffer.from(PRIME_TOKEN);

  return given.length === expected.length &&
    crypto.timingSafeEqual(given, expected);
}

async function getBinanceAccount() {
  if (!BINANCE_KEY || !BINANCE_SECRET) {
    throw new Error("Binance API credentials are missing in Render");
  }

  const params = new URLSearchParams({
    timestamp: Date.now().toString(),
    recvWindow: "5000"
  });

  const signature = crypto
    .createHmac("sha256", BINANCE_SECRET)
    .update(params.toString())
    .digest("hex");

  const url = BINANCE_URL + "/api/v3/account?" +
    params.toString() + "&signature=" + signature;

  const response = await fetch(url, {
    headers: { "X-MBX-APIKEY": BINANCE_KEY },
    signal: AbortSignal.timeout(10000)
  });

  const result = await response.json();

  if (!response.ok) {
    throw new Error(
      result.msg || "Binance rejected the account request"
    );
  }

  return result;
}

const server = http.createServer(async (req, res) => {
  let pathname;

  try {
    pathname = new URL(req.url, "http://localhost").pathname;
  } catch {
    return send(res, 400, { error: "Invalid request URL" });
  }

  if (req.method === "OPTIONS") {
    res.writeHead(204, {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, OPTIONS",
      "Access-Control-Allow-Headers": "Authorization, Content-Type"
    });
    return res.end();
  }

  if (req.method === "GET" && pathname === "/health") {
    return send(res, 200, {
      app: "PrimeTrade",
      status: "online",
      mode: "testnet",
      message: "Backend is responding"
    });
  }

  if (req.method === "GET" && pathname === "/api/account") {
    if (!PRIME_TOKEN) {
      return send(res, 503, {
        error: "PrimeTrade access token is not configured"
      });
    }

    if (!isAuthorized(req)) {
      return send(res, 401, {
        error: "Unauthorized",
        message: "A valid PrimeTrade access token is required"
      });
    }

    try {
      const account = await getBinanceAccount();

      const balances = (account.balances || []).filter(
        item => Number(item.free) > 0 ||
          Number(item.locked) > 0
      );

      return send(res, 200, {
        app: "PrimeTrade",
        connected: true,
        mode: "testnet",
        accountType: account.accountType,
        canTrade: account.canTrade,
        balances
      });
    } catch (error) {
      console.error("Account request failed:", error.message);

      return send(res, 502, {
        error: "Binance account request failed",
        message: error.message
      });
    }
  }

  return send(res, 404, {
    error: "Endpoint not found",
    path: pathname
  });
});

server.listen(PORT, "0.0.0.0", () => {
  console.log("PrimeTrade backend listening on port " + PORT);
});
