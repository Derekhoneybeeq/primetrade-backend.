
"use strict";

const http = require("http");
const crypto = require("crypto");

const PORT = process.env.PORT || 3000;

const BINANCE_API_KEY = process.env.BINANCE_API_KEY;
const BINANCE_API_SECRET = process.env.BINANCE_API_SECRET;
const PRIME_ACCESS_TOKEN = process.env.PRIMETRADE_ACCESS_TOKEN;

const BINANCE_BASE_URL = "https://testnet.binance.vision";

function sendJson(res, status, data) {
  res.writeHead(status, {
    "Content-Type": "application/json; charset=utf-8",
    "Cache-Control": "no-store",
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods": "GET, OPTIONS",
    "Access-Control-Allow-Headers": "Authorization, Content-Type"
  });

  res.end(JSON.stringify(data));
}

function tokenIsValid(req) {
  const header = req.headers.authorization || "";
  const prefix = "Bearer ";

  if (!PRIME_ACCESS_TOKEN || !header.startsWith(prefix)) {
    return false;
  }

  const supplied = Buffer.from(header.slice(prefix.length));
  const expected = Buffer.from(PRIME_ACCESS_TOKEN);

  if (supplied.length !== expected.length) {
    return false;
  }

  return crypto.timingSafeEqual(supplied, expected);
}

async function getBinanceAccount() {
  if (!BINANCE_API_KEY || !BINANCE_API_SECRET) {
    throw new Error(
      "Binance credentials are missing from Render environment variables"
    );
  }

  const params = new URLSearchParams({
    recvWindow: "5000",
    timestamp: Date.now().toString()
  });

  const signature = crypto
    .createHmac("sha256", BINANCE_API_SECRET)
    .update(params.toString())
    .digest("hex");

  const url =
    BINANCE_BASE_URL +
    "/api/v3/account?" +
    params.toString() +
    "&signature=" +
    signature;

  const response = await fetch(url, {
    method: "GET",
    headers: {
      "X-MBX-APIKEY": BINANCE_API_KEY
    },
    signal: AbortSignal.timeout(10000)
  });

  const data = await response.json();

  if (!response.ok) {
    const error = new Error(
      data.msg || "Binance account request failed"
    );
    error.status = response.status;
    throw error;
  }

  return data;
}

const server = http.createServer(async (req, res) => {
  if (req.method === "OPTIONS") {
    res.writeHead(204, {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, OPTIONS",
      "Access-Control-Allow-Headers": "Authorization, Content-Type",
      "Access-Control-Max-Age": "600"
    });
    return res.end();
  }

  const pathname = new URL(
    req.url,
    "http://localhost"
  ).pathname;

  if (req.method === "GET" && pathname === "/health") {
    return sendJson(res, 200, {
      app: "PrimeTrade",
      status: "online",
      mode: "testnet",
      message: "Backend is responding"
    });
  }

  if (req.method === "GET" && pathname === "/api/account") {
    if (!PRIME_ACCESS_TOKEN) {
      return sendJson(res, 503, {
        error: "PrimeTrade access token is not configured on the server"
      });
    }

    if (!tokenIsValid(req)) {
      return sendJson(res, 401, {
        error: "Unauthorized",
        message: "A valid PrimeTrade access token is required"
      });
    }

    try {
      const account = await getBinanceAccount();

      const balances = (account.balances || [])
        .filter(item =>
          Number(item.free) > 0 ||
          Number(item.locked) > 0
        );

      return sendJson(res, 200, {
        app: "PrimeTrade",
        connected: true,
        mode: "testnet",
        accountType: account.accountType,
        canTrade: account.canTrade,
        balances
      });
    } catch (error) {
      console.error("Account request failed:", error.message);

      const message =
        error.name === "TimeoutError"
          ? "Binance request timed out. Please try again."
          : error.message;

      return sendJson(res, 502, {
        error: "Binance account request failed",
        message
      });
    }
  }

  return sendJson(res, 404, {
    error: "Endpoint not found"
  });
});

server.listen(PORT, "0.0.0.0", () => {
  console.log(
    "PrimeTrade backend listening on port " + PORT
  );
});
